<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="6dp"
    android:background="#F5F5F5"
    android:layout_marginBottom="1dp">
    <TextView android:id="@+id/colSno" android:layout_width="0dp" android:layout_weight="0.6" android:layout_height="wrap_content" android:textColor="#000000" android:gravity="center"/>
    <TextView android:id="@+id/colLength" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textColor="#000000" android:gravity="center"/>
    <TextView android:id="@+id/colParam2" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textColor="#000000" android:gravity="center"/>
    <TextView android:id="@+id/colQty" android:layout_width="0dp" android:layout_weight="0.8" android:layout_height="wrap_content" android:textColor="#000000" android:gravity="center"/>
    <TextView android:id="@+id/colVol" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textColor="#000000" android:gravity="center"/>
</LinearLayout>
