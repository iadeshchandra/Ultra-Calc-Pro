xml
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#111827"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1E293B"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Macronutrient Calorie Counter"
                android:textColor="#22D3EE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etCarbs"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="#0F172A"
                android:hint="Carbohydrates (g)"
                android:textColorHint="#64748B"
                android:textColor="#F8FAFC"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etProtein"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="#0F172A"
                android:hint="Protein (g)"
                android:textColorHint="#64748B"
                android:textColor="#F8FAFC"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etFat"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="#0F172A"
                android:hint="Dietary Fats (g)"
                android:textColorHint="#64748B"
                android:textColor="#F8FAFC"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="SUM TOTAL CALORIES"
                android:textColor="#020617"
                android:textStyle="bold"
                app:backgroundTint="#22D3EE"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Nutritional data log matrix."
        android:textColor="#94A3B8"
        android:textSize="15sp"
        android:lineSpacingExtra="6dp"
        android:gravity="center"/>
</LinearLayout>
