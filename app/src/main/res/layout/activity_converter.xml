<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">
        
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK"
            android:backgroundTint="@android:color/transparent"
            android:textColor="#64748B"
            android:textStyle="bold"
            android:elevation="0dp"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OMNI &amp; WOOD CONVERTER"
            android:textColor="#22D3EE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dropdownContainer"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="#111827"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:hintTextColor="#22D3EE"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <AutoCompleteTextView
            android:id="@+id/modeSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Metric Layer"
            android:inputType="none"
            android:textColor="#F8FAFC"/>
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/dropdownContainer">

        <EditText
            android:id="@+id/inputPrimary"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#111827"
            android:padding="12dp"
            android:hint="Value / Length (ft)"
            android:textColorHint="#64748B"
            android:inputType="numberDecimal"
            android:textColor="#F8FAFC"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inputSecondary"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#111827"
            android:padding="12dp"
            android:hint="Width / Girth (in)"
            android:textColorHint="#64748B"
            android:inputType="numberDecimal"
            android:textColor="#F8FAFC"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inputTertiary"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#111827"
            android:padding="12dp"
            android:hint="Thickness (in)"
            android:textColorHint="#64748B"
            android:inputType="numberDecimal"
            android:textColor="#F8FAFC"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inputPricePerUnit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#111827"
            android:padding="12dp"
            android:hint="Price per CFT / Unit (Optional)"
            android:textColorHint="#64748B"
            android:inputType="numberDecimal"
            android:textColor="#F8FAFC"/>
    </LinearLayout>

    <TextView
        android:id="@+id/resultDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ready"
        android:textColor="#22D3EE"
        android:textSize="22sp"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/inputContainer"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#111827"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/resultDisplay"
        app:layout_constraintBottom_toTopOf="@id/btnAction">
        
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">
            <TextView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transaction &amp; Calculation Log..."
                android:textColor="#64748B"
                android:lineSpacingExtra="6dp"/>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="RUN COMPLEX CALCULATION"
        android:backgroundTint="#22D3EE"
        android:textColor="#020617"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
