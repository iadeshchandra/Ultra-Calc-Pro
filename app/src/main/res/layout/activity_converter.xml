<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textSize="24sp"
            android:textColor="#F8FAFC"
            app:cornerRadius="24dp"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OMNI &amp; WOOD CONVERTER"
            android:textColor="#22D3EE"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dropdownContainer"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="#111827"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:hintTextColor="#22D3EE"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <AutoCompleteTextView
            android:id="@+id/modeSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Metric Mode"
            android:inputType="none"
            android:textColor="#F8FAFC"/>
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/dropdownContainer">

        <EditText
            android:id="@+id/inputPrimary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#111827"
            android:padding="12dp"
            android:hint="Enter Value"
            android:textColorHint="#64748B"
            android:inputType="numberDecimal"
            android:textColor="#F8FAFC"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inputSecondary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#111827"
            android:padding="12dp"
            android:hint="Width / Girth (in)"
            android:textColorHint="#64748B"
            android:inputType="numberDecimal"
            android:textColor="#F8FAFC"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/inputTertiary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#111827"
            android:padding="12dp"
            android:hint="Thickness (in)"
            android:textColorHint="#64748B"
            android:inputType="numberDecimal"
            android:textColor="#F8FAFC"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputPieces"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="#111827"
                android:padding="12dp"
                android:hint="No. of Pieces"
                android:textColorHint="#64748B"
                android:inputType="number"
                android:text="1"
                android:textColor="#F8FAFC"
                android:visibility="gone"
                android:layout_marginEnd="4dp"/>

            <EditText
                android:id="@+id/inputPricePerUnit"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1.2"
                android:background="#111827"
                android:padding="12dp"
                android:hint="Price per Unit (৳)"
                android:textColorHint="#64748B"
                android:inputType="numberDecimal"
                android:textColor="#F8FAFC"
                android:visibility="gone"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/resultDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="0.00"
        android:textColor="#22D3EE"
        android:textSize="24sp"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/inputContainer"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#111827"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/resultDisplay"
        app:layout_constraintBottom_toTopOf="@id/btnAction">
        
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">
            <TextView
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculation Records Session..."
                android:textColor="#64748B"
                android:lineSpacingExtra="6dp"/>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="RUN SYSTEM ESTIMATE"
        android:backgroundTint="#22D3EE"
        android:textColor="#020617"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
