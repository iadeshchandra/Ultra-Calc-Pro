<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#E0F2F1">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tell me the Price"
        android:textColor="#00695C"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etRate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/border_rect"
        android:hint="Rate per Unit (৳)"
        android:textColorHint="#94A3B8"
        android:textColor="#000000"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seller Details"
        android:textColor="#00695C"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etSellerName"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/border_rect"
        android:hint="Seller Name"
        android:textColor="#000000"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etSellerPhone"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/border_rect"
        android:hint="Seller Phone"
        android:inputType="phone"
        android:textColor="#000000"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Customer Details"
        android:textColor="#00695C"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etCustomerName"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/border_rect"
        android:hint="Customer Name"
        android:textColor="#000000"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etCustomerPhone"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/border_rect"
        android:hint="Customer Phone"
        android:inputType="phone"
        android:textColor="#000000"
        android:padding="12dp"/>
</LinearLayout>
